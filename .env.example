# ---------------------------------------------------------------------------
# x-mail environment
# Copy to .env and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

APP_ENV=development
HTTP_ADDR=:8090
# Origin(s) allowed to call the API with credentials, comma-separated.
CORS_ORIGINS=http://localhost:5180
# Public base URL of the web app, used to build links in outgoing emails.
APP_BASE_URL=http://localhost:5180

# Postgres. Host ports are shifted (5433/6380) so this stack never collides
# with another local Postgres/Redis.
DATABASE_URL=postgres://xmail:xmail@localhost:5433/xmail?sslmode=disable

# Integration tests run against a separate database and Redis DB so they can
# truncate freely without touching development data. Tests skip when unset.
TEST_DATABASE_URL=postgres://xmail:xmail@localhost:5433/xmail_test?sslmode=disable
TEST_REDIS_ADDR=localhost:6380
TEST_REDIS_DB=1

# Redis (cache, pub/sub, Asynq queue)
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Session cookie signing. Generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_NAME=xmail_session
SESSION_TTL_HOURS=720
# Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Master key used to encrypt provider API keys at the application layer.
# AES-256-GCM, so this must decode to exactly 32 bytes.
# Generate: openssl rand -base64 32
# NEVER store this in Postgres; in production load it from a secrets manager.
ENCRYPTION_MASTER_KEY=

# Attachment storage: "local" or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional mail used by the platform itself (verification, password
# resets). Separate from the per-mail-account Resend keys users add in the app.
SYSTEM_RESEND_API_KEY=
SYSTEM_MAIL_FROM=x-mail <noreply@example.com>

# Multiplies every endpoint's rate-limit allowance. Must stay 1 in production;
# raise it only for a trusted deployment or a test environment.
RATE_LIMIT_SCALE=1

# Signing secret for the Resend inbound/event webhook (Svix format).
RESEND_WEBHOOK_SECRET=
